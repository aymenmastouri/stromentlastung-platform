{
  "realm": "stromentlastung",
  "displayName": "Stromentlastung – Referenzverfahren",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "de",
    "en"
  ],
  "defaultLocale": "de",
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "antragsteller",
        "description": "Nutzerkonto eines Unternehmens"
      },
      {
        "name": "sachbearbeitung",
        "description": "Sachbearbeitung des Hauptzollamts"
      },
      {
        "name": "zeichnung",
        "description": "Zeichnungsbefugnis des Hauptzollamts"
      },
      {
        "name": "pruefdienst",
        "description": "Außenprüfung oder Innenrevision"
      }
    ]
  },
  "clients": [
    {
      "clientId": "stromentlastung-web",
      "name": "Stromentlastung Oberfläche",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:4202",
      "baseUrl": "http://localhost:4202",
      "redirectUris": [
        "http://localhost:4202/*",
        "http://localhost:8090/*"
      ],
      "webOrigins": [
        "http://localhost:4202",
        "http://localhost:8090"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4202/*##http://localhost:8090/*"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "unternehmen",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "unternehmen",
            "claim.name": "unternehmen",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "dienststelle",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "dienststelle",
            "claim.name": "dienststelle",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
